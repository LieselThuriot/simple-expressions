{
  "name": "simple-expressions",
  "version": "1.2.0",
  "description": "Simple expression parsing and execution",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "parser",
    "lexer",
    "script",
    "execution"
  ],
  "author": "Liesel Thuriot",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/clean.js && tsc && node scripts/minify.js",
    "test": "npm run build && vitest run",
    "demo": "cd demo && npm install && npm run dev",
    "demo:build": "npm run build && cd demo && npm install && npm run build",
    "demo:preview": "cd demo && npm install && npm run preview",
    "pack:check": "npm pack --dry-run",
    "release": "npm pack && npm publish",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LieselThuriot/simple-expressions.git"
  },
  "bugs": {
    "url": "https://github.com/LieselThuriot/simple-expressions/issues"
  },
  "homepage": "https://github.com/LieselThuriot/simple-expressions#readme"
}
